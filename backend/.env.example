# Copy this file to  backend/.env  and fill it in. run-backend.ps1 / run-backend.sh load it automatically.
# .env is git-ignored. NEVER commit real passwords.

# Supabase -> your project -> "Connect" button -> "Session pooler"  (IPv4 friendly)
#   host looks like  aws-0-<region>.pooler.supabase.com   (region shown in the dialog)
#   user looks like  postgres.<your-project-ref>
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=your-database-password

# Long random string used to sign admin login tokens
APP_JWT_SECRET=replace-with-a-long-random-string-at-least-64-characters-long-0123456789abcdef

# First admin login, created automatically the first time the app starts on an empty database
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=choose-a-strong-password

# Where the React app is served from (comma separated)
APP_CORS_ORIGINS=http://localhost:5173

# Optional: fixed API key for the first kiosk (leave blank = random, printed in the console once)
APP_DEVICE_API_KEY=

# Optional: create 8 demo people (5 students, a lecturer, a Rev. Father, a guest — slots 1-8) on an empty database
APP_SEED_DEMO=false
